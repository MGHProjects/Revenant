{
  "name": "revenant",
  "version": "0.1.0",
  "description": "Link-rot checker and document patcher",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "revenant": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli/index.js",
    "build:mcp": "esbuild src/mcp/index.ts --bundle --platform=node --format=esm --outfile=dist/mcp/index.js",
    "build": "npm run build:cli && npm run build:mcp && vite build && wrangler deploy --dry-run",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "deploy": "npm run build:cli && npm run build:mcp && vite build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.0.0"
  }
}
